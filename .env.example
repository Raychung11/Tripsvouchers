# SLV Voucher Goodie Platform
APP_NAME="SLV Voucher Goodie"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

# Encryption key for QR voucher tokens (32 bytes, base64)
APP_KEY=base64:CHANGE_ME_TO_A_RANDOM_32_BYTE_KEY_BASE64ENCODED=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slv_voucher
DB_USERNAME=root
DB_PASSWORD=

# Billplz (https://www.billplz.com/api)
BILLPLZ_BASE_URL=https://www.billplz-sandbox.com/api/v3
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE=

# OpenAI (for AI Tour Guide)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Voucher pricing (RM)
VOUCHER_REDEMPTION_FEE=1.50
WALLET_MIN_BALANCE=100
WALLET_MIN_RELOAD=100
SUBSCRIPTION_ANNUAL_FEE=150

# Default language: en | zh | ms
DEFAULT_LANG=en
